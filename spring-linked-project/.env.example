# Copiar a .env (no se versiona) y completar con los valores locales. El perfil dev lo carga solo
# (spring.config.import en application-dev.yml) si la app se corre desde esta carpeta.
# En producción estas mismas variables se cargan como secretos del entorno (Fly.io): ver
# docs/guia-entorno-local-y-despliegue.md. Nunca poner valores reales en este archivo.

# ── Obligatorias en dev ──────────────────────────────────────────────────────
# Contraseña de PostgreSQL local (usuario postgres, base linked-main-db salvo DATABASE_URL).
DATABASE_PASSWORD=
# Clave HMAC de los JWT, en Base64 y de 32 bytes o más: openssl rand -base64 48
JWT_SECRET=

# ── Opcionales en dev ────────────────────────────────────────────────────────
# Otra base u otro usuario (descomentar: vacías pisarían el valor por defecto).
# DATABASE_URL=jdbc:postgresql://localhost:5432/linked-main-db
# DATABASE_USER=postgres
# Contraseña que se le pone al usuario admin sembrado (queda sin contraseña desde V18).
ADMIN_DEV_PASSWORD=
# Integraciones: vacías = desactivadas en dev.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
META_APP_ID=
META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:8080/api/instagram/callback
NEWS_API_KEY=

# ── Solo producción (perfil prod) ────────────────────────────────────────────
# DATABASE_URL, DATABASE_USER, DATABASE_PASSWORD, JWT_SECRET
# RSA_PRIVATE_KEY      clave privada PEM PKCS#8: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
# CORS_ORIGINS         orígenes del cliente web, separados por coma
# FRONT_BASE_URL       URL del cliente web (enlaces de mails y vuelta del OAuth de Instagram)
# MAIL_HOST, MAIL_PORT, MAIL_USERNAME, MAIL_PASSWORD, MAIL_FROM
# RECAPTCHA_SECRET_KEY
# CLOUDINARY_CLOUD_NAME, CLOUDINARY_API_KEY, CLOUDINARY_API_SECRET
# META_APP_ID, META_APP_SECRET, META_REDIRECT_URI
# Opcionales: JWT_EXPIRATION (ms, 24 h por defecto), INSTAGRAM_SYNC_INTERVAL (ISO-8601, PT2H), NEWS_API_KEY
