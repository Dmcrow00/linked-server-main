# Copiar a .env (sin comitear) y completar con los valores reales locales.
# spring-dotenv carga este archivo automaticamente al arrancar el perfil dev
# desde este directorio (spring-linked-project/) - no hace falta configurar nada mas.

DATABASE_PASSWORD=

# Opcionales - dejar vacio para desactivar la integracion correspondiente en dev
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
META_APP_ID=
META_APP_SECRET=
RECAPTCHA_SECRET_KEY=
NEWS_API_KEY=
