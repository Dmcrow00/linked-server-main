# Variables locales: .env no se versiona; la plantilla del backend sí (sin valores reales)
*.env
.env.example
!spring-linked-project/.env.example

# Configuración local de Claude Code
.claude/

# Clave RSA de dev del backend - cada entorno genera/inyecta la suya
# (rsa-privada.pem la genera core-security; rsa-keypair.ser es el formato anterior)
**/rsa-privada.pem
**/rsa-keypair.ser

# Maven
target/
*.class

# Backend Node retirado: si quedó una copia local (node_modules, uploads con imágenes de usuarios),
# que no se vuelva a versionar
nodejs-legacy/

# Eclipse / Spring Tools / IntelliJ
.classpath
.project
.factorypath
.settings/
.idea/
*.iml

# VS Code: se versiona solo la configuración compartida
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/
*.vsix

# Reportes y metadatos del sistema
coverage
.DS_Store
Thumbs.db
